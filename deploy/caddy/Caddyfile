{$DOMAIN} {
	tls /certs/origin.pem /certs/origin.key

	encode gzip

	request_body {
		max_size 64KB
	}

	reverse_proxy app:8000 {
		header_up X-Real-IP {http.request.header.CF-Connecting-IP}
	}
}

# Without a site block for www, Caddy answers the unmatched Host with an empty
# 200 — a blank white page rather than an error, so nothing looks broken.
www.{$DOMAIN} {
	tls /certs/origin.pem /certs/origin.key
	redir https://{$DOMAIN}{uri} permanent
}
